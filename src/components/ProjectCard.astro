---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card" id={project.name}>
  <h2>
    <a href={project.repo}>{project.name}</a>
  </h2>
  <p class="tagline">{project.tagline}</p>
  <p>{project.description}</p>
  <p class="lang">{project.language}</p>
</article>

<style>
  .card {
    position: relative;
    padding: 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 150ms ease;
  }

  .card:hover {
    border-color: #39404b;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tagline,
  .lang {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .lang {
    font-family: var(--font-mono);
    margin-top: 0.75rem;
  }
</style>
