---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { getCollection } from "astro:content";
import { byNewest } from "../lib/posts";
import { formatDate } from "../lib/format";

const posts = byNewest(await getCollection("writing"));
---

<Base>
  <section class="hero">
    <h1>Aditya Verma</h1>
    <p>
      I build developer tools and AI agents: small, sharp utilities for the
      terminal and the menu bar, and the plumbing that keeps agents honest.
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section>
    <h2>Writing</h2>
    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <a href={`/writing/${post.id}`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  section + section {
    margin-top: 3.5rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .hero p {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 36rem;
  }
</style>
