---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Base>
  <section class="hero">
    <h1>Aditya Verma</h1>
    <p>
      I build developer tools and AI agents: small, sharp utilities for the
      terminal and the menu bar, and the plumbing that keeps agents honest.
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  section + section {
    margin-top: 3.5rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .hero p {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 36rem;
  }
</style>
