---
import Base from "../layouts/Base.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { projects } from "../data/projects";
import { getPosts } from "../lib/content";
import PostList from "../components/PostList.astro";

const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>Aditya Verma</h1>
    <p>
      I build developer tools and AI agents: small, sharp utilities for the
      terminal and the menu bar, and the plumbing that keeps agents honest.
    </p>
    <p class="cta">
      <a href="/projects/">see projects</a>
      <a href="/writing/">read writing</a>
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <ProjectGrid projects={projects} />
  </section>

  <section>
    <h2>Writing</h2>
    <PostList posts={posts} />
    <p class="more"><a href="/writing/">all writing →</a></p>
  </section>
</Base>

<style>
  .more {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }

  .hero .cta {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .hero p {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 36rem;
  }
</style>
