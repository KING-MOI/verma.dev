---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/content";
import { neighbors } from "../../lib/posts";
import { serializeJsonLd } from "../../lib/json-ld";
import { formatDate } from "../../lib/format";
import { readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, ...neighbors(posts, post.id) },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Aditya Verma" },
};
---

<Base title={post.data.title} description={post.data.description} type="article">
  <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>·{" "}
        {minutes} min read
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="pager">
    {older && <a href={`/writing/${older.id}/`}>← {older.data.title}</a>}
    {newer && (
      <a class="newer" href={`/writing/${newer.id}/`}>
        {newer.data.title} →
      </a>
    )}
  </nav>
</Base>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .newer {
    margin-left: auto;
    text-align: right;
  }

  .meta {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>
